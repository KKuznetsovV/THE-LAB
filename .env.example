# Copy to .env and fill in. Never commit .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
THELAB_DB_HOST=database
THELAB_DB_PASSWORD=change-me

# --- Auth (shared by every service that verifies JWTs) ---
THELAB_JWT_SECRET=change-me-to-a-long-random-string
# First owner account, created by identity-service only when no admins exist
THELAB_ADMIN_EMAIL=owner@thelabtlv.com
THELAB_ADMIN_PASSWORD=change-me-strong-password

# --- MinIO / S3 ---
MINIO_ROOT_USER=thelab
MINIO_ROOT_PASSWORD=change-me-minio
THELAB_S3_ENDPOINT=http://minio:9000
THELAB_S3_PUBLIC_ENDPOINT=http://localhost:9200
THELAB_S3_BUCKET=thelab-media
THELAB_S3_PUBLIC_BASE_URL=http://localhost:8080/media

# --- Public site ---
THELAB_SITE_URL=http://localhost:8080
THELAB_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
