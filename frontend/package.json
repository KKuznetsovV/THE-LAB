{
  "name": "thelab-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "docker": "vite --mode=docker",
    "build": "tsc -b && vite build",
    "build:docker": "vite build --mode=docker && node ../scripts/prerender.mjs && node ../scripts/sitemap.mjs docker",
    "build:production": "tsc -b && vite build --mode=production && node ../scripts/prerender.mjs && node ../scripts/sitemap.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@thelab/lib": "file:../lib",
    "axios": "^1.13.6",
    "i18next": "^26.5.11",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^17.1.9",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.5"
  }
}
