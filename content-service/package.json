{
  "name": "thelab-content-service",
  "version": "0.0.0",
  "private": true,
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "docker": "cross-env NODE_ENV=docker node dist/app.js",
    "compose": "cross-env NODE_ENV=compose node dist/app.js",
    "production": "cross-env NODE_ENV=production node dist/app.js"
  },
  "dependencies": {
    "@thelab/lib": "file:../lib",
    "config": "^4.4.1",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3"
  }
}
